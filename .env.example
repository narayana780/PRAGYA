# ==================================================
# PRAGYA ENVIRONMENT CONFIGURATION
# ==================================================

# Environment Mode: development | staging | production
ENVIRONMENT=development

# Database & Vector Storage (Native PostgreSQL with pgvector on Windows)
# Format: postgresql://postgres:<PASSWORD>@localhost:5432/pragya
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/pragya
VECTOR_DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/pragya

# Security & Authentication (JWT)
JWT_SECRET=super_secret_pragya_jwt_key_change_in_production_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# API Configuration
API_V1_STR=/api/v1
API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AI Provider Abstractions (Native Python / Local LLM / API Compatible)
LLM_PROVIDER=mock
LLM_MODEL=llama-3-8b-instruct
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=your_optional_llm_api_key_here
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AI Learning Assistant Safeguards & Context Limits
ASSISTANT_HISTORY_MESSAGES=8
MAX_MESSAGES_PER_MINUTE=20
MAX_TOKENS_PER_REQUEST=1024
MAX_CONTEXT_CHUNKS=5

# Government / Ecosystem Integration Provider Modes (mock | live)
IGOT_PROVIDER_MODE=mock
NSSTA_PROVIDER_MODE=mock
